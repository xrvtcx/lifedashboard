# Neon Postgres connection string.
# Neon dashboard -> your project -> "Connection Details" -> copy the pooled connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require

# The single shared password used to protect the whole app.
APP_PASSWORD=change-me

# Any long random string, used to sign the session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
